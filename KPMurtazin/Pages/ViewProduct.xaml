<Page x:Class="KPMurtazin.Pages.ViewProduct"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:KPMurtazin.Pages"
      mc:Ignorable="d"
      MinHeight="450" MinWidth="950"
      Title="ViewProduct" Loaded="Page_Loaded" Background="#FFF4F4F9">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
            <RowDefinition Height="70" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <StackPanel Margin="35 0 0 0">
                <TextBlock Text="Категория:" Style="{StaticResource text}" />
                <ComboBox Name="cbFilter" DropDownClosed="cbFilter_DropDownClosed" SelectedIndex="{Binding MenuC.ID_Category}" />
            </StackPanel>
            <StackPanel Margin="35 0 0 0">
                <TextBlock Text="Поиск:"  ToolTip="dffdf" Style="{StaticResource text}" />
                <TextBox MinWidth="550" Name="tbSearch" TextChanged="tbSearch_TextChanged" Style="{StaticResource TextBoxStyle}" />
            </StackPanel>
            <Button Content="Генерировать отчет" Click="btn_ReportClick" Style="{StaticResource darkGreyButton}" />
        </StackPanel>
        <ListBox x:Name="lbProduct" Grid.Row="1" Background="Transparent"  ScrollViewer.CanContentScroll="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="{Binding Photo}" Grid.Column="0" Width="300" Height="250" />
                        <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="0 20 0 0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Название: " Style="{StaticResource text}" />
                                    <TextBlock Text="{Binding Nazvanie}" Style="{StaticResource text}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Описание: "  Style="{StaticResource text}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource text}" Width="800" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Категория: " Style="{StaticResource text}" />
                                    <TextBlock Text="{Binding MenuC.Name}" Style="{StaticResource text}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Cost, StringFormat=Цена: 0.00 ₽}" Style="{StaticResource text}" />
                                <Separator />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button Content="Удалить" Margin="5" Style="{StaticResource cancellingButton}"
                                        Click="btn_DeleteClick" />
                                    <Button Content="Изменить" Margin="5"
                                        Click="btn_UpdateClick" Style="{StaticResource editingButton}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button Content="Добавить" Click="btn_AddClick" Style="{StaticResource darkGreyButton}"
            Grid.Row="2" Width="175" Margin="10"
            HorizontalAlignment="Right" />
    </Grid>
</Page>