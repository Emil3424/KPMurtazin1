<Page x:Class="KPMurtazin.Pages.AddSotrudniki"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:KPMurtazin.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddSotrudniki">

    <Grid>
        <StackPanel>
            <StackPanel Margin="50 0 50 15">
                <TextBlock Text="ФИО:" Style="{StaticResource text}" />
                <TextBox Name="FIOT" Text="{Binding FIO}" Style="{StaticResource TextBoxStyle}" Height="35" />
            </StackPanel>

            <StackPanel Margin="50 0 50 15">
                <TextBlock Text="Гендер:" Style="{StaticResource text}" />
                <TextBox Name="GenderT" Text="{Binding Gender}" Style="{StaticResource TextBoxStyle}" Height="35" />
            </StackPanel>

            <StackPanel Margin="50 0 50 15">
                <TextBlock Text="Адресс:" Style="{StaticResource text}" />
                <TextBox Name="AdresT" Text="{Binding Adress}" Style="{StaticResource TextBoxStyle}" Height="35" />
            </StackPanel>

            <StackPanel Margin="50 0 50 15">
                <TextBlock Text="Работа:" Style="{StaticResource text}" />
                <TextBox x:Name="JobT" Width="auto" Style="{StaticResource TextBoxStyle}" Height="35"
            Text="{Binding Job}" />
            </StackPanel>
            <StackPanel Margin="50 0 50 15">
                <TextBlock Text="Зарплата:" Style="{StaticResource text}" />
                <TextBox x:Name="SalaryT" Width="auto" Style="{StaticResource TextBoxStyle}" Height="35"
            Text="{Binding Salary}" />
            </StackPanel>

            <StackPanel Margin="50 0 50 15">
                <TextBlock Text="Обучение:" Style="{StaticResource text}" />
                <TextBox x:Name="EducationT" Width="auto" Style="{StaticResource TextBoxStyle}" Height="35"
                         Text="{Binding Education}" />
            </StackPanel>

            <StackPanel Margin="50 0 50 15">
                <TextBlock Text="Телефон:" Style="{StaticResource text}" />
                <TextBox x:Name="TelephonT" Width="auto" Style="{StaticResource TextBoxStyle}" Height="35"
                         Text="{Binding Telephon}" />
            </StackPanel>
            <Button Content="Сохранить" Width="200" Click="btnSave_Click" Style="{StaticResource buttonMainGreen}" RenderTransformOrigin="0.48,1.087" Height="45"  Background="#FF3BD4AC" />
        </StackPanel>
    </Grid>
</Page>