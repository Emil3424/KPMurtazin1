<Page x:Class="KPMurtazin.Pages.PayMenu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:KPMurtazin.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800" MinHeight="450" MinWidth="800"
      Title="PayMenu">

    <Grid>
        <ScrollViewer Margin="10,10,10,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Ваши товары" FontSize="36" Margin="10,10,10,10" Foreground="#FFAE8B48" />
                </StackPanel>
                <ItemsControl x:Name="ProductsList" Margin="10,30,10,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                <Border BorderBrush="#1f1f1f" BorderThickness="1">
                                    <Image Source="{Binding Photo}" Width="100" Height="100" />
                                </Border>
                                <TextBlock Text="{Binding Nazvanie}" Margin="5,0" VerticalAlignment="Center" Foreground="#363636" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Cost, StringFormat=Цена: 0.00 ₽}" Margin="5,0" VerticalAlignment="Center" Foreground="#FFAE8B48" FontSize="16" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Итоговая цена продуктов: " Name="CenaProduct" Style="{StaticResource text}" HorizontalAlignment="Center" FontSize="18" />
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>