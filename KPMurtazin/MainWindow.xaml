<Window x:Class="KPMurtazin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KPMurtazin"
        mc:Ignorable="d"
        Title="Кото-кафе" Height="700" Width="1350" MinHeight="700" MinWidth="1350" Background="#FFF4F4F9" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Grid.Row="1" Background="#ebe1cd">

            <StackPanel x:Name="NavigationMenu" Background="#ebe1cd" Width="150" Height="auto"
                HorizontalAlignment="Left" VerticalAlignment="Top">
                <Button Content="Главная" Margin="10"
                Click="Navigate_Click" Style="{StaticResource darkGreyButton}" />
                <Button Content="Создание заказа" Margin="10"
                Click="Navigate_Click" Style="{StaticResource darkGreyButton}" />
                <Button Content="Сотрудники" Margin="10"
                Click="Navigate_Click" Style="{StaticResource darkGreyButton}" />
                <Button Content="Тут будет отчет" Margin="10"
                Click="Navigate_Click" Style="{StaticResource darkGreyButton}" />

                <Button Content="Назад" Style="{StaticResource darkGreyButton}" Background="#330911"
                        Click="btnGoBack_Click" Margin="10" />
            </StackPanel>
        </Grid>

        <Frame x:Name="MainFrame" Grid.Row="1" Grid.Column="1"
       NavigationUIVisibility="Hidden" />
    </Grid>
</Window>